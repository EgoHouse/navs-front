# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Authentication
VITE_JWT_TOKEN_KEY=navs_auth_token

# Nota: Cloudinary se gestiona desde el backend
# El frontend solo consume URLs, no sube archivos

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true

# Environment
# development | staging | production
NODE_ENV=development
